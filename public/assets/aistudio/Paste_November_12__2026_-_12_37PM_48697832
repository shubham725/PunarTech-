<script>
  function updateCounters() {
    var currentDate = new Date();
    var startDate = new Date("2022-02-01");
    var newDate = new Date("2024-07-20");

    var timeDifference = currentDate.getTime() - startDate.getTime();
    var timeDifference2 = currentDate.getTime() - newDate.getTime();
    var minutesElapsed = Math.floor(timeDifference / 60000);
    var minutesElapsed2 = Math.floor(timeDifference2 / 60000);
    var hoursElapsed = Math.floor(minutesElapsed2 / 60);

    if (isNaN(minutesElapsed)) {
      setTimeout(updateCounters, 100);
      return;
    }

    var initialHappyCustomers = 100050;
    var customersAddedPerHour = 8;
    var totalCustomers = initialHappyCustomers + (customersAddedPerHour * hoursElapsed);
    var co2ReducedInKilotonnes = (minutesElapsed * 220) / 1_000_000;
    var co2ReduceValue = co2ReducedInKilotonnes.toLocaleString(undefined, {
      minimumFractionDigits: 3,
      maximumFractionDigits: 3
    });

    var odoMeterElementHC = document.querySelector('#happyCustomers odo-meter');
    var odoMeterElementCOR = document.querySelector('#Co2Reduced odo-meter');

    if (odoMeterElementHC && odoMeterElementCOR) {
      odoMeterElementHC.setAttribute('data-counter', totalCustomers);
      odoMeterElementHC.innerHTML = totalCustomers;

      odoMeterElementCOR.setAttribute('data-counter', co2ReduceValue);
      odoMeterElementCOR.innerHTML = co2ReduceValue;
    }
  }

  function waitForElementsAndStart() {
    var hc = document.querySelector('#happyCustomers odo-meter');
    var cor = document.querySelector('#Co2Reduced odo-meter');

    if (hc && cor) {
      updateCounters();
      setInterval(updateCounters, 1000); // Run every second
    } else {
      setTimeout(waitForElementsAndStart, 100); // Try again shortly
    }
  }

  window.addEventListener('load', waitForElementsAndStart);
</script>

