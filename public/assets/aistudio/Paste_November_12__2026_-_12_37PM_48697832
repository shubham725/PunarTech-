  function njSubmitSearch(q) {
    if (!q) return false;
    var type = njDetectType(q);
    var brands = njDetectBrand(q);
    /* Apple laptops are product type "MacBooks", not "Laptops" */
    if (brands && brands[0] === 'Apple' && type === 'Laptops') type = 'MacBooks';
    var url = '/search?type=product,collection&q=' + encodeURIComponent(q); 
    if (type) url += '&filter.p.product_type=' + encodeURIComponent(type);
    if (brands) {
      for (var b = 0; b < brands.length; b++) url += '&filter.p.vendor=' + encodeURIComponent(brands[b]);
    }
    url += '&options[unavailable_products]=last';
    window.location.href = url;
    return true;
  }

  document.addEventListener('submit', function (e) {
    var form = njGetSearchForm(e.target);
    if (!form) return;
    var input = form.querySelector('input[name="q"]');
    if (input && njSubmitSearch(input.value.trim())) { e.preventDefault(); e.stopPropagation(); }
  }, true);

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' && e.keyCode !== 13) return;
    if (!e.target || e.target.name !== 'q') return;
    var form = njGetSearchForm(e.target);
    if (form && njSubmitSearch(e.target.value.trim())) { e.preventDefault(); e.stopPropagation(); }
  }, true);

  document.addEventListener('click', function (e) {
    var btn = e.target && e.target.closest
      ? e.target.closest('button[type="submit"], button:not([type]), input[type="submit"]')
      : null;
    if (!btn) return;
    var form = btn.form || njGetSearchForm(btn);
    if (!form) return;
    form = njIsSearchForm(form) ? form : null;
    if (!form) return;
    var input = form.querySelector('input[name="q"]');
    if (input && njSubmitSearch(input.value.trim())) { e.preventDefault(); e.stopPropagation(); }
  }, true);

})();
