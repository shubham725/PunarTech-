<!-- CODE 1 JS — track-based one-card-at-a-time slide + auto-slide -->
<script>
(function() {
  var tswAllItems = ['item1','item2','item3','item4','item5','item6'];
  var tswVisible  = 3;
  var tswGap      = 10; // px, must match CSS gap
  var tswStart    = 0;
  var tswActive   = 'item1';
  var tswAutoInterval = null;
  var TSW_AUTO_DELAY  = 2000;
  var tswIsAnimating  = false;

  var track = document.getElementById('tswTrack');
  var wrap  = document.querySelector('.tsw-grid-wrap');

  // ===== COMPUTE & SET CARD WIDTH =====
  function tswSetCardWidth() {
    if (!wrap) return;
    var wrapW   = wrap.clientWidth;
    var cardW   = (wrapW - (tswGap * (tswVisible - 1))) / tswVisible;
    // Apply to all cards via inline style
    document.querySelectorAll('.tsw-item').forEach(function(el) {
      el.style.width    = cardW + 'px';
      el.style.flexBasis = cardW + 'px';
      el.style.flexGrow  = '0';
      el.style.flexShrink = '0';
    });
    return cardW;
  }

  // ===== COMPUTE TRANSLATE X FOR CURRENT tswStart =====
  function tswGetTranslate() {
    if (!wrap) return 0;
    var wrapW  = wrap.clientWidth;
    var cardW  = (wrapW - (tswGap * (tswVisible - 1))) / tswVisible;
    // Each step = one card width + one gap
    return -(tswStart * (cardW + tswGap));
  }

  // ===== APPLY TRANSFORM (animated) =====
  function tswApplyTransform(animate) {
    if (!track) return;
    track.style.transition = animate
      ? 'transform 0.55s cubic-bezier(0.4, 0, 0.2, 1)'
      : 'none';
    track.style.transform = 'translateX(' + tswGetTranslate() + 'px)';
  }

  // ===== UPDATE ACTIVE & BUTTONS =====
  function tswUpdateUI() {
    tswAllItems.forEach(function(name, i) {
      var el = document.querySelector('.tsw-item[data-item="' + name + '"]');
      if (!el) return;
      el.classList.toggle('tsw-item-selected', name === tswActive);
    });
    document.getElementById('tswPrevBtn').classList.toggle('tsw-invisible', tswStart === 0);
    document.getElementById('tswNextBtn').classList.toggle('tsw-invisible', tswStart + tswVisible >= tswAllItems.length);
  }

  // ===== SLIDE TO A POSITION =====
  function tswGoTo(newStart, newActive) {
    if (tswIsAnimating) return;
    tswIsAnimating = true;
    tswStart  = newStart;
    tswActive = newActive;
    tswApplyTransform(true);
    tswUpdateUI();
    setTimeout(function() { tswIsAnimating = false; }, 600);
  }

  // ===== AUTO-SLIDE: one card forward, loop at end =====
  function tswAutoNext() {
    var nextStart;
    var nextActive;
    if (tswStart + tswVisible < tswAllItems.length) {
      nextStart  = tswStart + 1;
      nextActive = tswAllItems[nextStart + tswVisible - 1];
    } else {
      // Loop: jump back to 0 without animation, then animate
      tswIsAnimating = false;
      tswStart  = 0;
      tswActive = tswAllItems[0];
      tswApplyTransform(false); // instant reset
      tswUpdateUI();
      return;
    }
    tswGoTo(nextStart, nextActive);
  }

  function tswStartAuto() {
    tswStopAuto();
    tswAutoInterval = setInterval(tswAutoNext, TSW_AUTO_DELAY);
  }
  function tswStopAuto() {
    if (tswAutoInterval) { clearInterval(tswAutoInterval); tswAutoInterval = null; }
  }

  // ===== MANUAL PREV/NEXT =====
  window.tswSlide = function(dir) {
    tswStopAuto();
    if (tswIsAnimating) return;
    var nextStart = tswStart;
    var nextActive = tswActive;
    if (dir === 'next' && tswStart + tswVisible < tswAllItems.length) {
      nextStart  = tswStart + 1;
      nextActive = tswAllItems[nextStart + tswVisible - 1];
    } else if (dir === 'prev' && tswStart > 0) {
      nextStart  = tswStart - 1;
      nextActive = tswAllItems[nextStart];
    }
    tswGoTo(nextStart, nextActive);
    setTimeout(tswStartAuto, 4000);
  };

  // ===== CLICK ON CARD =====
  document.querySelectorAll('.tsw-item').forEach(function(el) {
    el.addEventListener('click', function() {
      tswStopAuto();
      var name = el.getAttribute('data-item');
      var idx  = tswAllItems.indexOf(name);
      var newStart = tswStart;
      // Bring clicked card into view
      if (idx < tswStart) {
        newStart = idx;
      } else if (idx >= tswStart + tswVisible) {
        newStart = idx - tswVisible + 1;
      }
      tswGoTo(newStart, name);
      setTimeout(tswStartAuto, 4000);
    });
  });

  // ===== PAUSE ON HOVER =====
  var tswWrapper = document.querySelector('.tsw-wrapper');
  if (tswWrapper) {
    tswWrapper.addEventListener('mouseenter', tswStopAuto);
    tswWrapper.addEventListener('mouseleave', tswStartAuto);
  }

  // ===== RESIZE: recalculate card widths & transform =====
  window.addEventListener('resize', function() {
    tswSetCardWidth();
    tswApplyTransform(false);
  });

  // ===== INIT =====
  tswSetCardWidth();
  tswApplyTransform(false);
  tswUpdateUI();
  tswStartAuto();
})();
</script>



