  function njWords(q) {
    return (q || '').trim().toLowerCase().split(/\s+/).filter(function (w) { return w.length > 1; });
  }

  function njMatches(text, words) {
    var t = text.toLowerCase();
    return words.every(function (w) {
      if (t.indexOf(w) > -1) return true;
      if (w.length > 5 && w.slice(-1) === 's') return t.indexOf(w.slice(0, -1)) > -1;
      return false;
    });
  }

  function njFilterPredictiveProducts() {
    var input = document.querySelector('[data-search-input]');
    var rawQ = (input && input.value) || '';
    var words = njWords(rawQ);
    if (!words.length) return;
