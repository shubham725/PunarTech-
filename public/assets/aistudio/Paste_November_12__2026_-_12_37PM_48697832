<script>
/*
  Script 5 (NJ, 27 Oct 2026): keep the sort class on #CollectionProductsParent in step with the
  current sort, on collection AND search pages. The theme changes sort/filters without reloading
  (AJAX + URL update) and only replaces the products inside #CollectionProductsParent, so its class
  kept the first-load sort (e.g. "manual"). assets/nj-collection-card.css reads that class to skip the
  in-stock -> pre-order grouping on price sorts, so after changing to "Price, low/high" pre-order cards
  were still pushed after in-stock ones. This makes price sorts a strict price order (sold-out last),
  exactly like a fresh page load.
*/
(function () {
  'use strict';
  var NJ_SORTS = ['manual', 'most-relevant', 'relevance', 'best-selling', 'title-ascending', 'title-descending',
                  'price-ascending', 'price-descending', 'created-ascending', 'created-descending'];

  var njDefaultSort = null; /* the page's own sort at first load, used when the URL has no sort_by */

  function njSyncSortClass() {
    var p = document.getElementById('CollectionProductsParent');
    if (!p) return;
    if (njDefaultSort === null) {
      njDefaultSort = '';
      for (var j = 0; j < NJ_SORTS.length; j++) if (p.classList.contains(NJ_SORTS[j])) njDefaultSort = NJ_SORTS[j];
    }
    var s = new URLSearchParams(window.location.search).get('sort_by') || njDefaultSort;
    if (!s || NJ_SORTS.indexOf(s) === -1 || p.classList.contains(s)) return;
    for (var i = 0; i < NJ_SORTS.length; i++) p.classList.remove(NJ_SORTS[i]);
    p.classList.add(s);
  }

  ['pushState', 'replaceState'].forEach(function (m) {
    var orig = history[m];
    if (typeof orig !== 'function') return;
    history[m] = function () {
      var r = orig.apply(this, arguments);
      try { njSyncSortClass(); } catch (e) {}
      return r;
    };
  });
  window.addEventListener('popstate', njSyncSortClass);

  function njAttach() {
    njSyncSortClass();
    var p = document.getElementById('CollectionProductsParent');
    if (p && window.MutationObserver) {
      new MutationObserver(njSyncSortClass).observe(p, { childList: true, subtree: true });
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', njAttach);
  else njAttach();
})();
</script>



