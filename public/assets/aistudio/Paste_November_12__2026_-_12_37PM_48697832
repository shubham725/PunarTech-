<script>
(function () {
  /* helpers */
  function calcEMI(priceInPaise) {
    return Math.round((priceInPaise / 100) * 1.05 / 12);
  }

  function formatINR(n) {
    return n.toLocaleString('en-IN');
  }

  function isElementVisible(el) {
    return !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length);
  }

  function injectEMI(priceInPaise) {
    console.log('injectEMI called with priceInPaise:', priceInPaise);
    var emi = calcEMI(priceInPaise);
    var emiText = '₹' + formatINR(emi);

    var el = document.getElementById('emi-value');
    if (el) {
      // Reapply styles with !important to combat theme overrides
      el.style.cssText = 'font-weight:bolder !important; color:#000 !important; font-size:16px !important;';
      el.textContent = emiText;
      console.log('Updated existing #emi-value');
      return;
    }

    var priceWrap = document.querySelector('.product-price[data-price]');
    if (!priceWrap) {
      console.warn('No .product-price[data-price] element found');
      return;
    }

    var old = priceWrap.querySelector('.emi-wrapper');
    if (old) old.remove();

    var wrapper = document.createElement('span');
    wrapper.className = 'emi-wrapper';
    // Enforce styles with !important
    wrapper.style.cssText = 'display:block !important; width:100% !important; font-size:16px !important; color:#333 !important; margin-top:2px !important;';
    wrapper.innerHTML = 'EMI Starts At: <span id="emi-value" style="font-weight:bolder !important; color:#000 !important; font-size:16px !important;">'
                      + emiText + '</span>';
    priceWrap.appendChild(wrapper);
  }

  /* variant data */
  var productData = null;
  try {
    productData = JSON.parse(document.getElementById('emi-product-data').textContent);
  } catch(e) {
    console.error('Failed to parse product data', e);
  }

  function getPriceByVariantId(vid) {
    if (!productData) return null;
    for (var i = 0; i < productData.variants.length; i++) {
      if (productData.variants[i].id === vid) return productData.variants[i].price;
    }
    return null;
  }

  function safeInjectEMI(price, retries = 5) {
    console.log('safeInjectEMI', price, 'retries', retries);
    var priceSpan = document.querySelector('[data-regular-price]');
    if (!priceSpan) {
      if (retries > 0) setTimeout(() => safeInjectEMI(price, retries - 1), 100);
      return;
    }
    if (retries > 0 && !isElementVisible(priceSpan)) {
      setTimeout(() => safeInjectEMI(price, retries - 1), 100);
      return;
    }
    injectEMI(price);
  }

  /* initial load */
  document.addEventListener('DOMContentLoaded', function () {
    safeInjectEMI();
  });

  /* watch variant ID input */
  function watchVariantInput() {
    var variantInput = document.querySelector('input[name="id"]');
    if (!variantInput) return;
    var lastId = variantInput.value;
    var obs = new MutationObserver(function() {
      if (variantInput.value !== lastId) {
        lastId = variantInput.value;
        var price = getPriceByVariantId(parseInt(lastId, 10));
        if (price) safeInjectEMI(price);
      }
    });
    obs.observe(variantInput, { attributes: true, attributeFilter: ['value'] });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', watchVariantInput);
  } else {
    watchVariantInput();
  }

  /* fallback change event */
  document.addEventListener('change', function (e) {
    var form = e.target.closest('form[action*="/cart/add"]');
    if (!form || !productData) return;
    var vidInput = form.querySelector('input[name="id"]');
    if (vidInput) {
      var price = getPriceByVariantId(parseInt(vidInput.value, 10));
      if (price) safeInjectEMI(price);
    }
  });

  /* custom events */
  ['variant:changed','variantChange','variant-change'].forEach(function (evName) {
    document.addEventListener(evName, function (e) {
      var v = e.detail && (e.detail.variant || e.detail);
      if (v && v.price) safeInjectEMI(v.price);
    });
  });

  /* body observer to catch full replacements */
  function startBodyObserver() {
    var observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        if (mutation.type === 'childList') {
          var priceSpan = document.querySelector('[data-regular-price]');
          if (priceSpan && !priceSpan.querySelector('.emi-wrapper')) {
            var priceWrap = document.querySelector('[data-price]');
            var raw = priceWrap ? parseInt(priceWrap.getAttribute('data-price'), 10) : NaN;
            if (!isNaN(raw) && raw > 0) safeInjectEMI(raw);
          }
        }
      });
    });
    observer.observe(document.body, { childList: true, subtree: true });
  }
  startBodyObserver();
})();
</script>
        
