<script>
(function(){
  var KEY='njrb.code', TTL=30*24*60*60*1000, PAT=/^(LXZ|LXR)-[A-Z0-9]+$/i;

  function store(c){ try{ localStorage.setItem(KEY, JSON.stringify({c:c,t:Date.now()})); }catch(e){} }
  function saved(){
    try{
      var r=JSON.parse(localStorage.getItem(KEY)||'null');
      if(r && r.c && Date.now()-r.t < TTL) return r.c;
    }catch(e){}
    return null;
  }
  function dismissed(){ try{ return sessionStorage.getItem('njrb.x')==='1'; }catch(e){ return false; } }

  function fromUrl(){
    var q=new URLSearchParams(location.search);
    var keys=['discount','discount_code','code','coupon','ref_code'];
    for(var i=0;i<keys.length;i++){ var v=q.get(keys[i]); if(v && PAT.test(v)) return v.toUpperCase(); }
    var m=location.pathname.match(/\/discount\/([^\/?#]+)/i);
    if(m && PAT.test(decodeURIComponent(m[1]))) return decodeURIComponent(m[1]).toUpperCase();
    return null;
  }
  function fromCookie(){
    var m=document.cookie.match(/(?:^|;\s*)discount_code=([^;]+)/);
    if(m){ var v=decodeURIComponent(m[1]); if(PAT.test(v)) return v.toUpperCase(); }
    return null;
  }
  function fromCart(cb){
    fetch('/cart.js',{credentials:'same-origin'}).then(function(r){return r.json();}).then(function(c){
      var out=null;
      (c.discount_codes||[]).forEach(function(d){ if(d && d.code && PAT.test(d.code)) out=d.code.toUpperCase(); });
      (c.cart_level_discount_applications||[]).forEach(function(d){
        var t=d && (d.title||d.key); if(t && PAT.test(t)) out=String(t).toUpperCase();
      });
      cb(out);
    }).catch(function(){ cb(null); });
  }

  function show(code){
    if(!code || dismissed()) return;
    var bar=document.getElementById('njrb');
    if(!bar) return;
    document.getElementById('njrb-code').textContent=code;
    if(/^LXR-/i.test(code)){
      bar.querySelector('.njrb-title').innerHTML='You&#8217;ve earned <b>&#8377;1,000</b> for referring a friend!';
    }
    bar.hidden=false;
    var h=bar.offsetHeight;
    document.body.style.paddingBottom=(h+8)+'px';
    document.documentElement.style.setProperty('--njrb-h', h+'px');
    document.documentElement.classList.add('njrb-on');
  }

  function init(){
    var code=fromUrl()||fromCookie();
    if(code){ store(code); show(code); return; }
    code=saved();
    if(code){ show(code); return; }
    fromCart(function(c){ if(c){ store(c); show(c); } });
    // Loox may apply the code a moment after the page loads, so check once more
    setTimeout(function(){
      if(!document.getElementById('njrb').hidden) return;
      var c2=fromCookie(); if(c2){ store(c2); show(c2); return; }
      fromCart(function(c){ if(c){ store(c); show(c); } });
    }, 3000);
  }

  document.addEventListener('click', function(e){
    if(e.target && e.target.id==='njrb-copy'){
      var t=document.getElementById('njrb-code').textContent.trim(), b=e.target;
      var done=function(){ b.textContent='Copied!'; setTimeout(function(){ b.textContent='Copy code'; },1800); };
      if(navigator.clipboard && navigator.clipboard.writeText){
        navigator.clipboard.writeText(t).then(done, function(){ fallback(t); done(); });
      } else { fallback(t); done(); }
    }
    if(e.target && e.target.id==='njrb-x'){
      try{ sessionStorage.setItem('njrb.x','1'); }catch(err){}
      var bar=document.getElementById('njrb');
      if(bar){ bar.hidden=true; document.body.style.paddingBottom=''; }
      document.documentElement.classList.remove('njrb-on');
    }
  });
  function fallback(t){
    var ta=document.createElement('textarea'); ta.value=t; ta.style.position='fixed'; ta.style.opacity='0';
    document.body.appendChild(ta); ta.select();
    try{ document.execCommand('copy'); }catch(err){}
    document.body.removeChild(ta);
  }

  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded', init); } else { init(); }
})();
</script>

