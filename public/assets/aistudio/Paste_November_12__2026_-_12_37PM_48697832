<script>
document.addEventListener('DOMContentLoaded', () => {
  const container = document.querySelector('[data-scroll-jack]');
  if (!container) return;

  const stickyWrapper = container.querySelector('[data-sticky-wrapper]');
  const slidesTrack = container.querySelector('[data-slides-track]');
  const dots = container.querySelectorAll('[data-dot]');
  const progressBar = container.querySelector('[data-progress-bar]');
  const scrollHint = container.querySelector('[data-scroll-hint]');
  const totalSlides = container.querySelectorAll('[data-slide]').length;

  let currentIndex = 0;
  let autoScrollInterval = null;
  let autoScrollResumeTimeout = null;
  let touchStartX = 0;
  let touchStartY = 0;
  const AUTO_SCROLL_DELAY = 2500;

  function isMobile() {
    return window.innerWidth <= 768;
  }

  function isElementVisible(element) {
    const rect = element.getBoundingClientRect();
    return rect.bottom > 0 && rect.top < window.innerHeight;
  }

  function updateUI() {
    slidesTrack.style.transform = `translateX(${currentIndex * -100}%)`;

    dots.forEach((dot, i) => {
      dot.classList.toggle('active', i === currentIndex);
    });

    if (progressBar) {
      const progress = totalSlides > 1 ? currentIndex / (totalSlides - 1) : 1;
      progressBar.style.width = `${progress * 100}%`;
    }
  }

  function goToSlide(index) {
    if (index < 0 || index >= totalSlides) return;
    currentIndex = index;
    updateUI();
  }

  function goToNextSlide() {
    goToSlide(currentIndex + 1 >= totalSlides ? 0 : currentIndex + 1);
  }

  function stopAutoScroll() {
    if (autoScrollInterval) {
      clearInterval(autoScrollInterval);
      autoScrollInterval = null;
    }
    if (autoScrollResumeTimeout) {
      clearTimeout(autoScrollResumeTimeout);
      autoScrollResumeTimeout = null;
    }
  }

  function startAutoScroll() {
    stopAutoScroll();
    if (!isMobile() || totalSlides <= 1) return;

    autoScrollInterval = setInterval(() => {
      if (!isElementVisible(container)) return;
      goToNextSlide();
    }, AUTO_SCROLL_DELAY);
  }

  function pauseAutoScrollTemporarily() {
    stopAutoScroll();
    autoScrollResumeTimeout = setTimeout(startAutoScroll, 4000);
  }

  function setupDesktopMode() {
    stopAutoScroll();
    container.style.height = '70vh';
    stickyWrapper.style.position = 'relative';
    slidesTrack.style.transform = 'translateX(0)';
    if (progressBar) progressBar.parentElement.style.display = 'none';
    if (scrollHint) scrollHint.style.display = 'none';
  }

  function setupMobileMode() {
    container.style.height = 'auto';
    stickyWrapper.style.position = 'relative';
    if (progressBar) progressBar.parentElement.style.display = '';
    if (scrollHint) scrollHint.style.display = 'none';
    goToSlide(0);
    startAutoScroll();
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      if (!isMobile() || i === currentIndex) return;
      goToSlide(i);
      pauseAutoScrollTemporarily();
    });
  });

  stickyWrapper.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
  }, { passive: true });

  stickyWrapper.addEventListener('touchend', (e) => {
    if (!isMobile()) return;

    const deltaX = e.changedTouches[0].clientX - touchStartX;
    const deltaY = e.changedTouches[0].clientY - touchStartY;

    if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 50) {
      const nextIndex = currentIndex + (deltaX < 0 ? 1 : -1);
      if (nextIndex >= 0 && nextIndex < totalSlides) {
        goToSlide(nextIndex);
        pauseAutoScrollTemporarily();
      }
    }
  }, { passive: true });

  let wasMobile = isMobile();
  window.addEventListener('resize', () => {
    const nowMobile = isMobile();

    if (wasMobile !== nowMobile) {
      wasMobile = nowMobile;
      if (nowMobile) {
        setupMobileMode();
      } else {
        setupDesktopMode();
      }
      return;
    }

    if (nowMobile) {
      updateUI();
    }
  });

  if (isMobile()) {
    setupMobileMode();
  } else {
    setupDesktopMode();
  }
});
</script>

