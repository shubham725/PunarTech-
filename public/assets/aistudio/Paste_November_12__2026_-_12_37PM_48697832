  <script>
/*
  Script 0: Predictive search performance — debounce + cache + limit optimisation.

  Debounce (150ms): waits until the user pauses typing before firing the
  /search/suggest API call. Typing "laptop" quickly sends 1 request instead
  of 6, reducing server load and eliminating jitter from stale results.

  Limit optimisation: rewrites resources[limit]=10 → resources[limit]=5 so
  Shopify fetches and renders only as many products as we display.
  Reduces server-side Liquid rendering time.

  Cache (12 entries, per page-load): revisiting a recent query is served
  from memory instantly — zero network round-trip.

  Only intercepts /search/suggest calls; everything else passes through
  the native fetch unchanged.
*/
(function () {
  'use strict';
  var _orig  = window.fetch;
  var _cache = {};
  var _cacheQ = [];
  var MAX_CACHE = 12;

  window.fetch = function (resource, init) {
    var url = (typeof resource === 'string') ? resource
            : (resource && resource.url) ? resource.url : '';

    /* Pass through anything that isn't a predictive-search call */
    if (url.indexOf('/search/suggest') === -1) {
      return _orig.apply(this, arguments);
    }

        /* Raise the product limit to 10 (Shopify's max) so the stock-based
       sort has a full candidate pool to pick the top 5 from */
    var optUrl = url
      .replace(/resources%5Blimit%5D=\d+/g, 'resources%5Blimit%5D=10')
      .replace(/resources\[limit\]=\d+/g,   'resources[limit]=10');
    
    /* NJ (26 Oct 2026): show sold-out products in search, but AFTER in-stock/pre-order ones (was =show) */
    if (optUrl.indexOf('unavailable_products') === -1) {
      optUrl += '&resources[options][unavailable_products]=last';
    }

    /* Cache hit — return stored text as a fresh Response immediately */
    if (_cache[optUrl]) {
      return Promise.resolve(
        new Response(_cache[optUrl], {
          status: 200,
          headers: { 'Content-Type': 'application/json' }
        })
      );
    }

    /* Fire immediately — no debounce timer */
    var p = _orig.call(this, optUrl, init);

    p.then(function (response) {
      response.clone().text().then(function (text) {
        if (_cacheQ.length >= MAX_CACHE) delete _cache[_cacheQ.shift()];
        _cache[optUrl] = text;
        _cacheQ.push(optUrl);
      });
    }).catch(function () {});

    return p;
  };
})();
</script>


<script>
/*
  Script 2: Search form interceptor.
  Adds type filter (Laptops, Desktops, etc.) and redirects on submit.
*/
(function () {

  var NJ_PHRASE_MAP = [
    ['all in one',  'Desktop Computers'],
    ['all-in-one',  'Desktop Computers'],
    ['mini pc',     'Mini PC'],
    ['mini-pc',     'Mini PC'],
    ['gaming pc',   'Desktops']
  ];
  var NJ_WORD_MAP = [
    [['laptop', 'laptops', 'notebook', 'notebooks'], 'Laptops'],
    [['desktop', 'desktops'],                         'Desktops'],
    [['chromebook', 'chromebooks'],                   'Chromebooks'],
    [['chromebox', 'chromeboxes'],                    'Chromeboxes'],
    [['monitor', 'monitors'],                         'Computer Monitors'],
    [['tablet', 'tablets'],                           'Tablet Computers'],
    [['aio'],                                         'Desktop Computers']
  ];

  function njDetectType(q) {
    var lower = q.toLowerCase().trim();
    for (var i = 0; i < NJ_PHRASE_MAP.length; i++) {
      if (lower.indexOf(NJ_PHRASE_MAP[i][0]) > -1) return NJ_PHRASE_MAP[i][1];
    }
    var words = lower.split(/\s+/);
    for (var j = 0; j < NJ_WORD_MAP.length; j++) {
      var tw = NJ_WORD_MAP[j][0];
      for (var k = 0; k < tw.length; k++) {
        if (words.indexOf(tw[k]) > -1) return NJ_WORD_MAP[j][1];
      }
    }
    return null;
  }

  window._njDetectType = njDetectType;

  /* NJ (26 Oct 2026): brand words in the search add a Brand (vendor) filter, so "dell laptops"
     shows only Dell products (also when sorted by price). Values = vendor names in Shopify (only vendors
     that have active products - an unknown value makes the search return 0 results).
     Two different brands in one search = no brand filter. */
  var NJ_BRAND_MAP = [
    [['dell'],                                  ['Dell']],
    [['hp'],                                    ['HP']],
    [['lenovo', 'lenevo', 'thinkpad'],          ['Lenovo']],
    [['acer'],                                  ['Acer']],
    [['asus'],                                  ['Asus']],
    [['apple', 'macbook', 'macbooks', 'imac'],  ['Apple']],
    [['toshiba'],                               ['Toshiba']],
    [['hcl'],                                   ['HCL']]
  ];

  function njDetectBrand(q) {
    var words = q.toLowerCase().trim().split(/[\s,]+/);
    var found = null;
    for (var i = 0; i < NJ_BRAND_MAP.length; i++) {
      var bw = NJ_BRAND_MAP[i][0];
      for (var k = 0; k < bw.length; k++) {
        if (words.indexOf(bw[k]) > -1) {
          if (found && found !== NJ_BRAND_MAP[i][1]) return null;
          found = NJ_BRAND_MAP[i][1];
        }
      }
    }
    return found;
  }

  window._njDetectBrand = njDetectBrand;

  function njIsSearchForm(form) {
    if (!form || form.tagName !== 'FORM') return false;
    if (form.classList.contains('predictive-search')) return true;
    if (form.hasAttribute('data-mg-search')) return true;
    var action = form.getAttribute('action') || '';
    if (action === '/search' || action.indexOf('/search?') === 0) return true;
    if (form.querySelector('input[name="q"]')) return true;
    return false;
  }

  function njGetSearchForm(el) {
    var node = el;
    while (node && node !== document.body) {
      if (njIsSearchForm(node)) return node;
      node = node.parentElement;
    }
    return null;
  }

  function njSubmitSearch(q) {
    if (!q) return false;
    var type = njDetectType(q);
    var brands = njDetectBrand(q);
    /* Apple laptops are product type "MacBooks", not "Laptops" */
    if (brands && brands[0] === 'Apple' && type === 'Laptops') type = 'MacBooks';
    var url = '/search?type=product,collection&q=' + encodeURIComponent(q); 
    if (type) url += '&filter.p.product_type=' + encodeURIComponent(type);
    if (brands) {
      for (var b = 0; b < brands.length; b++) url += '&filter.p.vendor=' + encodeURIComponent(brands[b]);
    }
    url += '&options[unavailable_products]=last';
    window.location.href = url;
    return true;
  }

  document.addEventListener('submit', function (e) {
    var form = njGetSearchForm(e.target);
    if (!form) return;
    var input = form.querySelector('input[name="q"]');
    if (input && njSubmitSearch(input.value.trim())) { e.preventDefault(); e.stopPropagation(); }
  }, true);

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' && e.keyCode !== 13) return;
    if (!e.target || e.target.name !== 'q') return;
    var form = njGetSearchForm(e.target);
    if (form && njSubmitSearch(e.target.value.trim())) { e.preventDefault(); e.stopPropagation(); }
  }, true);

  document.addEventListener('click', function (e) {
    var btn = e.target && e.target.closest
      ? e.target.closest('button[type="submit"], button:not([type]), input[type="submit"]')
      : null;
    if (!btn) return;
    var form = btn.form || njGetSearchForm(btn);
    if (!form) return;
    form = njIsSearchForm(form) ? form : null;
    if (!form) return;
    var input = form.querySelector('input[name="q"]');
    if (input && njSubmitSearch(input.value.trim())) { e.preventDefault(); e.stopPropagation(); }
  }, true);

})();
</script>

<script>
/*
  Script 3: AND filter on search results page.
*/
(function () {
  'use strict';
  if (window.location.pathname.indexOf('/search') === -1) return;

  var NJ_TYPE_WORDS = [
    'laptop','laptops','notebook','notebooks',
    'desktop','desktops','chromebook','chromebooks',
    'chromebox','chromeboxes','monitor','monitors',
    'tablet','tablets','aio','mini','pc','all','one','gaming'
  ];

  (function () {
    var params = new URLSearchParams(window.location.search);
    if (params.get('filter.p.product_type')) return;
    var ref = document.referrer || '';
    if (ref.indexOf('/search') > -1 && ref.indexOf(window.location.hostname) > -1) {
      try {
        var refQ = (new URL(ref).searchParams.get('q') || '').trim().toLowerCase();
        var curQ = (params.get('q') || '').trim().toLowerCase();
        if (refQ === curQ) return;
      } catch (e) {}
    }
    var q = (params.get('q') || '').trim();
    if (!q) return;
    var detect = window._njDetectType;
    if (typeof detect !== 'function') return;
    var type = detect(q);
    if (!type) return;
    params.set('type', 'product');
    params.set('filter.p.product_type', type);
    params.delete('page');
    window.location.replace('/search?' + params.toString());
  })();

  /* NJ (26 Oct 2026): safety net for the brand filter - if a search with a Brand (vendor) filter
     finds nothing, reload the same search without the brand filter instead of showing "0 results". */
  (function () {
    var params = new URLSearchParams(window.location.search);
    if (!params.getAll('filter.p.vendor').length) return;
    function njCheckEmpty() {
      /* only the search results area - the (empty) cart drawer uses the same .empty-card-box class */
      if (!document.querySelector('#CollectionProductsParent .empty-card-box')) return;
      params.delete('filter.p.vendor');
      window.location.replace('/search?' + params.toString());
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', njCheckEmpty);
    else njCheckEmpty();
  })();

  (function () {
    var params = new URLSearchParams(window.location.search);
    if (parseInt(params.get('page') || '1') <= 1) return;
    if (params.get('filter.p.product_type')) return;
    var words = (params.get('q') || '').trim().toLowerCase().split(/\s+/).filter(function (w) { return w.length > 1; });
    if (!words.length) return;
    params.delete('page');
    window.location.replace('/search?' + params.toString());
  })();

  function njGetWords() {
    var params = new URLSearchParams(window.location.search);
    var q = (params.get('q') || '').trim().toLowerCase();
    var words = q.split(/\s+/).filter(function (w) { return w.length > 1; });
    if (params.get('filter.p.product_type')) {
      words = words.filter(function (w) { return NJ_TYPE_WORDS.indexOf(w) === -1; });
    }
    return words;
  }

  function njTextMatches(text, words) {
    var t = text.toLowerCase();
    return words.every(function (w) {
      if (t.indexOf(w) > -1) return true;
      if (w.length > 5 && w.slice(-1) === 's') return t.indexOf(w.slice(0, -1)) > -1;
      return false;
    });
  }

  function njDoFilter() {
    var words = njGetWords();
    if (!words.length) return;
    var grid = document.querySelector('[data-collection-products]');
    if (!grid) return;
    var cards = grid.querySelectorAll('.col-12');
    var shown = 0, hidden = 0;
    var hasTypeFilter = !!(new URLSearchParams(window.location.search).get('filter.p.product_type'));
    Array.prototype.forEach.call(cards, function (card) {
      if (!card.querySelector('.product-card-item')) return;
      if (njTextMatches(card.textContent || '', words)) { card.style.display = ''; shown++; }
      else { card.style.display = 'none'; hidden++; }
    });
    if (hidden > 0 && !hasTypeFilter) {
      var pag = document.querySelector('[data-serach-pagination]');
      if (pag) pag.style.display = 'none';
    }
    if (hidden > 0 && !hasTypeFilter) {
      var el = document.querySelector('.searchbar-result-heading');
      if (el) {
        var origQ = (new URLSearchParams(window.location.search).get('q') || '').trim().replace(/</g, '&lt;');
        el.innerHTML = '<strong>' + shown + '</strong> results for &ldquo;' + origQ + '&rdquo;';
      }
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', njDoFilter);
  else njDoFilter();

  var njTimer;
  var njObs = new MutationObserver(function () {
    clearTimeout(njTimer);
    njTimer = setTimeout(njDoFilter, 150);
  });
  function njAttach() {
    var p = document.getElementById('CollectionProductsParent');
    if (p) njObs.observe(p, { childList: true, subtree: true });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', njAttach);
  else njAttach();
})();
</script>

<script>
