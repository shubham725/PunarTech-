<script>
  (function () {
    var wrapper = document.getElementById('DispatchInfo-productFormproduct-quick-view');
    var dataScript = document.getElementById('DispatchInfo-productFormproduct-quick-view-data');
    var textEl = wrapper ? wrapper.querySelector('[data-dispatch-text]') : null;

    var variantData = {};
    if (dataScript) {
      try {
        variantData = JSON.parse(dataScript.textContent);
      } catch (e) {}
    }

    function njDebugLog() {
      if (window.NJ_DEBUG_PREORDER) {
        try {
          console.log.apply(console, ['[NJ Preorder Sync]'].concat(Array.prototype.slice.call(arguments)));
        } catch (e) {}
      }
    }

    function isMobileViewport() {
      return window.matchMedia('(max-width: 768px)').matches;
    }

    /* Desktop PC products never show the badge (Liquid decides once per page). */
    var njHideDispatch = false;

    /* In stock = purchasable AND stock > 0 (or inventory not tracked). Same rule as the
       collection card; out-of-stock variants never show a dispatch value. */
    function isInStockVariant(v) {
      if (!v || !v.available) return false;
      /* 17 Oct 2026: purchasable pre-order variants (continue selling) count as well */
      return v.inventoryQuantity > 0 || v.inventoryPolicy === 'continue' || !v.inventoryManagement;
    }

    /* 8 Oct 2026: manual (ERP metafield) rule DISABLED - back on the Notify / Hengam Pre-order app
       rule (continue selling + no stock). Old rule kept for reference:
    function isPreorderVariant(v) {
      if (!v || typeof v.preOrderStatus !== 'string') return false;
      var norm = v.preOrderStatus.toLowerCase().replace(/[\s-]/g, '_').trim();
      return norm === 'pre_order' || norm === 'preorder';
    }
    */
    function isPreorderVariant(v) {
      if (!v) return false;
      return v.inventoryPolicy === 'continue' && Number(v.inventoryQuantity) <= 0;
    }

    function getFirstLineRect(el) {
      try {
        var range = document.createRange();
        range.selectNodeContents(el);
        var rects = range.getClientRects();
        if (rects.length > 0) return rects[0];
      } catch (e) {}
      return el.getBoundingClientRect();
    }

    function positionWishlistIcon() {
      var btn = document.querySelector(
        '.nm-wishlist-button.nm-PRODUCT_PAGE-wishlist-button'
      );
      if (!btn) return;

      var target = btn.closest('.nm-portal') || btn.parentElement || btn;

      if (isMobileViewport()) {
        target.style.removeProperty('position');
        target.style.removeProperty('top');
        target.style.removeProperty('left');
        target.removeAttribute('data-nj-wishlist-pos');
        return;
      }

      var titleEl = document.querySelector(
        '[data-product-title-row] .product-heading'
      );
      if (!titleEl) return;

      var rect = getFirstLineRect(titleEl);
      if (!rect || (rect.width === 0 && rect.height === 0)) return;

      var iconSize = 28;

      if (target.style.getPropertyValue('position') !== 'absolute') {
        target.style.setProperty('position', 'absolute', 'important');
      }

      var parent = target.offsetParent || document.body;
      var isRoot = parent === document.body || parent === document.documentElement;
      var parentRect = parent.getBoundingClientRect();

      var top = Math.round(
        rect.top + rect.height / 2 - iconSize / 2 - parentRect.top -
        (parent.clientTop || 0) + (isRoot ? 0 : parent.scrollTop)
      );

      var left = Math.round(
        rect.right + 12 - parentRect.left -
        (parent.clientLeft || 0) + (isRoot ? 0 : parent.scrollLeft)
      );

      var key = top + ':' + left;

      if (target.getAttribute('data-nj-wishlist-pos') === key) return;

      target.setAttribute('data-nj-wishlist-pos', key);
      target.style.setProperty('top', top + 'px', 'important');
      target.style.setProperty('left', left + 'px', 'important');
    }

    function updateMobileBuyNowLabel(preorder) {
      var wrap = document.querySelector('.breeze_button_mobile');
      if (!wrap) return;

      var breezeEl = wrap.querySelector('breeze-button');
      if (!breezeEl || !breezeEl.shadowRoot) return;

      var textEl = breezeEl.shadowRoot.querySelector('.breeze-button-text');
      if (!textEl) return;

      if (!textEl.dataset.originalText) {
        textEl.dataset.originalText = textEl.textContent.trim();
      }

      var desired = preorder ? 'Pre-order Now' : textEl.dataset.originalText;

      if (textEl.textContent.trim() !== desired) {
        textEl.textContent = desired;
      }
    }

    function updateBuyNowVisibility(preorder) {
      var formEl = document.getElementById('productFormproduct-quick-view');
      var scope = formEl || document;

      scope.querySelectorAll('.pdp-action-wrapper .breeze_button_desktop').forEach(function (el) {
        el.classList.toggle('nj-preorder-hide', preorder);
      });
    }

    function updateUI(variantId) {
      var v = variantData[variantId];

      if (v) {
        var preorder = isPreorderVariant(v);

        if (wrapper && textEl) {
          if (v.text && !njHideDispatch && isInStockVariant(v)) {
            textEl.textContent = v.text;
            wrapper.style.display = 'inline-flex';
          } else {
            wrapper.style.display = 'none';
          }
        }

        document.body.setAttribute(
          'data-variant-stock',
          v.available ? 'in' : 'out'
        );

        updateMobileBuyNowLabel(preorder);
        updateBuyNowVisibility(preorder);
      }

      positionWishlistIcon();
    }

    function watchVariantInput() {
      var form = document.getElementById('productFormproduct-quick-view');

      var input = form
        ? form.querySelector('input[name="id"]')
        : document.querySelector('input[name="id"]');

      if (!input) return;

      var lastId = input.value;

      updateUI(lastId);

      var observer = new MutationObserver(function () {
        if (input.value !== lastId) {
          lastId = input.value;
          updateUI(lastId);
        }
      });

      observer.observe(input, {
        attributes: true,
        attributeFilter: ['value']
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        watchVariantInput
      );
    } else {
      watchVariantInput();
    }

    document.addEventListener('change', function (e) {
      var form = e.target.closest('form[action*="/cart/add"]');

      if (!form) return;

      var vidInput = form.querySelector('input[name="id"]');

      if (vidInput) {
        updateUI(vidInput.value);
      }
    });

    var reflowObserver = new MutationObserver(function () {
      positionWishlistIcon();

      var form = document.getElementById('productFormproduct-quick-view');

      var input = form
        ? form.querySelector('input[name="id"]')
        : document.querySelector('input[name="id"]');

      if (input && variantData[input.value]) {
        updateMobileBuyNowLabel(
          isPreorderVariant(variantData[input.value])
        );
      }
    });

    reflowObserver.observe(document.body, {
      childList: true,
      subtree: true
    });

    positionWishlistIcon();

    var resizeTimeout;

    window.addEventListener('resize', function () {
      clearTimeout(resizeTimeout);

      resizeTimeout = setTimeout(
        positionWishlistIcon,
        100
      );
    });

    var scrollTicking = false;

    window.addEventListener(
      'scroll',
      function () {
        if (scrollTicking) return;

        scrollTicking = true;

        window.requestAnimationFrame(function () {
          positionWishlistIcon();
          scrollTicking = false;
        });
      },
      {
        passive: true
      }
    );
  })();
</script>

      


