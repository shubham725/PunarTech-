      : '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>';
  });

  /* Modal ATC */
  atcBtn.addEventListener

  function resetAtc() {
    atcBtn.classList.remove('state-loading', 'state-added');
    atcBtn.disabled = false;
    atcBtn.querySelector('.nj-btn-text').textContent = activeCard ? (activeCard.dataset.btnText || 'ADD TO CART') : 'ADD TO CART';
  }

  /* ══════════════════════════════════════
     AJAX ADD TO CART
  ══════════════════════════════════════ */
function updateCartUI(cart) {
  var sectionId = 'ajax-cart-drawer';

  if (typeof cartCountUpdate === 'function') {
    cartCountUpdate(cart.item_count);
  }

  var sectionHtml = cart.sections && cart.sections[sectionId];

  function applyCartHtml(html) {
    var tmp = document.createElement('div');
    tmp.innerHTML = html;
    var updatedSection = tmp.querySelector('.shopify-section');
    if (!updatedSection) return;

    var cartBody = document.querySelector('[data-cart-drwaer-body]');
    if (!cartBody) return;

    cartBody.innerHTML = updatedSection.innerHTML;

    if (typeof getQuantityElement       === 'function') getQuantityElement(cartBody);
    if (typeof getCartItemRemoveElements === 'function') getCartItemRemoveElements(cartBody);
    if (typeof cartNoteUpdate           === 'function') cartNoteUpdate();
    if (typeof cartGiftWrapElement      === 'function') cartGiftWrapElement(cartBody);
    if (typeof cartTermhandlerClick     === 'function') cartTermhandlerClick();
    if (typeof cartTermsHandler         === 'function') cartTermsHandler();

    var cartDrawer = document.querySelector('#' + sectionId + '[data-side-drawer]');
    if (cartDrawer) {
      cartDrawer.style.display = 'flex';
      setTimeout(function() {
        cartDrawer.classList.add('sidebar-visible');
      }, 300);
      document.querySelector('body').classList.add('no-scroll', 'popup-open');
    }
  }

  if (sectionHtml) {
    applyCartHtml(sectionHtml);
  } else {
    fetch('/?sections=' + sectionId)
      .then(function(r) { return r.json(); })
      .then(function(sections) {
        if (sections[sectionId]) applyCartHtml(sections[sectionId]);
      })
      .catch(function() {});
  }
}

function addToCart(variantId, trigger, onSuccess) {
  if (!variantId) return;

  var isAtc       = trigger === atcBtn;
  var isInlineAtc = trigger && trigger.classList.contains('nj-rv__inline-atc');
  var isChipAtc   = trigger && trigger.classList.contains('nj-rv__chip-atc');

  if (isAtc) {
    atcBtn.classList.add('state-loading'); atcBtn.disabled = true;
  } else if (trigger) {
    trigger.classList.add('state-loading'); trigger.disabled = true;
  }

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    body: JSON.stringify({
      id: parseInt(variantId, 10),
      quantity: 1,
      sections: ['ajax-cart-drawer']
    })
  })
  .then(function(r) { if (!r.ok) throw new Error(r.status); return r.json(); })
  .then(function(cart) {
    showToast('✓ Added to cart!');

    if (isAtc) {
      atcBtn.classList.remove('state-loading');
    } else if (trigger) {
      trigger.classList.remove('state-loading');
      trigger.disabled = false;
    }

    updateCartUI(cart);

    if (typeof onSuccess === 'function') {
      onSuccess();
    } else if (isChipAtc) {
      var origText = trigger.getAttribute('data-orig-text') || trigger.textContent;
      trigger.setAttribute('data-orig-text', origText);
      trigger.textContent = '✓ Added';
      setTimeout(function() { trigger.textContent = origText; }, 2000);
    }
  })
  .catch(function(err) {
    console.error('[nj-reels] cart/add error:', err);
    showToast('Could not add to cart. Please try again.');
    if (isAtc) { atcBtn.classList.remove('state-loading'); atcBtn.disabled = false; }
    else if (trigger) { trigger.classList.remove('state-loading'); trigger.disabled = false; }
  });
}

  /* ── Toast ── */
  function showToast(msg) {
    clearTimeout(toastTimer);
    toast.textContent = msg; toast.classList.add('is-visible');
    toastTimer = setTimeout(function() { toast.classList.remove('is-visible'); }, 2200);
  }

  slideTo(0);

  } /* ← closes init() */

