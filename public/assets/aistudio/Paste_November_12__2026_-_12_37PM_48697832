    .nm-wishlist-button.nm-PRODUCT_PAGE-wishlist-button span {
      display: none !important;
    }
  }

  /* The empty slot added in snippets/product-blocks.liquid is no
     longer used for positioning (positioning is JS/fixed-based
     now) — kept hidden, harmless leftover. */
  .wishlist-title-slot {
    display: none;
  }

  @media screen and (max-width: 768px) {
    /* Mobile: completely unchanged from before this update */
    .pdp-action-wrapper .quantity-inputs {
      display: none !important;
    }
    .pdp-action-wrapper .nm-portal:has(.nm-wishlist-button.nm-PRODUCT_PAGE-wishlist-button) {
      display: flex !important;
      order: 3 !important;
      flex: 0 0 54px !important;
      width: 54px !important;
      height: 48px !important;
      min-width: 54px !important;
      max-width: 54px !important;
      padding: 0 !important;
      margin: 0 !important;
      align-items: center !important;
      justify-content: center !important;
    }
    .pdp-action-wrapper .nm-wishlist-button.nm-PRODUCT_PAGE-wishlist-button {
      display: flex !important;
      width: 54px !important;
      height: 48px !important;
      padding: 0 !important;
      margin: 0 !important;
      border-radius: 8px !important;
      background: #ffffff !important;
      align-items: center !important;
      justify-content: center !important;
      /* outline, not border — the app forces its own inline
         "border" property which would otherwise win */
      outline: 2px solid #d5e3ef !important;
      outline-offset: -2px;
    }
    .pdp-action-wrapper .nm-wishlist-button.nm-PRODUCT_PAGE-wishlist-button > div {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 0 !important;
    }
    .pdp-action-wrapper .nm-wishlist-button.nm-PRODUCT_PAGE-wishlist-button svg {
      width: 22px !important;
      height: 22px !important;
      fill: #E50047 !important;
      stroke: #E50047 !important;
    }
    .pdp-action-wrapper .nm-wishlist-button.nm-PRODUCT_PAGE-wishlist-button span {
      display: none !important;
    }
  }

  /* ---------------------------------------------------------
     5) BUY NOW — KEEP VISIBLE FOR PREORDER ITEMS (≤768px)
     ROOT CAUSE (confirmed 20th Aug 2026): assets/base.css has a
     rule that hides Buy Now at small screens whenever it detects
     a sold-out button anywhere in the action bar:

       .pdp-action-wrapper:has(button[data-sold-out]) .breeze_button_mobile
         { display: none; }

     This is correct for genuinely sold-out products, but the
     Pre-order app's own markup can include sold-out-style
     elements even on preorder items (which ARE purchasable), so
     the rule can fire by mistake there too.

     Fix: whenever a Pre-order badge is present anywhere on the
     page, force Buy Now to stay visible — using multiple
     properties (display, visibility, opacity, position, width)
     as a comprehensive safeguard against any hiding technique.
     This is reactive: :has() re-evaluates live, so it keeps
     working through variant changes or re-renders. Genuinely
     sold-out (non-preorder) products are untouched — Buy Now
     stays hidden for them exactly as intended, since this rule
     only activates when a Pre-order badge exists at all.
     --------------------------------------------------------- */
  @media screen and (max-width: 768px) {
    body:has(.hengam-preorder-badge) .pdp-action-wrapper .breeze_button_mobile {
      display: block !important;
      visibility: visible !important;
      opacity: 1 !important;
      position: static !important;
      width: auto !important;
    }
  }

  /* ---------------------------------------------------------
     6) "NOTIFY ME" BUTTON — MOBILE ONLY (confirmed bug fix,
     22nd Aug 2026)
     Injected by the STOQ back-in-stock app (class:
     .restock-alerts-notify-button), wrapped in its own
     .nm-portal (same wrapper pattern as the wishlist button).

     CONFIRMED via direct inspection: this button's own class
     list includes "mobile-only-button" — the exact same class
     the theme uses for Share-mobile/ATC-mobile/etc to mean
     "hidden at desktop widths" — but the app forces it to
     render with display:flex on desktop anyway, ignoring that
     class. This is what caused the floating "Notify me" tab to
     appear on desktop, cluttering the layout alongside
     "Pre-order now" / "Buy it now". Confirmed reproducible on
     multiple variants, not a timing/loading artifact.

     Fix: respect the button's own stated intent — hide it at
     desktop widths, matching every other *-mobile button in
     this bar. Mobile is completely unaffected; it keeps working
     exactly as before.
     --------------------------------------------------------- */
  @media screen and (min-width: 769px) {
    .nm-portal:has(.restock-alerts-notify-button) {
      display: none !important;
    }
  }

  /* ---------------------------------------------------------
     7) "SOLD OUT" BUTTON — MOBILE ONLY (23rd Aug 2026)
     The native Add to Cart button (.ATC-mobile) carries a
     data-sold-out attribute specifically when the selected
     variant is genuinely out of stock (see
     snippets/product-form-buttons.liquid — this attribute is
     theme code, not app-injected). Pure CSS, no JS: hides it
     only in that exact state, mobile only. It's a direct flex
     child of .pdp-action-wrapper, so display:none collapses its
     space in the row automatically — no separate gap-removal
     rule needed. In-stock and preorder states are untouched,
     since this attribute is only present when sold out.
     --------------------------------------------------------- */
  @media screen and (max-width: 768px) {
    .ATC-mobile[data-sold-out] {
      display: none !important;
    }
  }

  /* ---------------------------------------------------------
     8) WISHLIST HEADER COUNT BADGE (26th Aug 2026)
     Small red circle showing how many items are in the wishlist,
     on the header icon in snippets/store-locator.liquid. Hidden
     (via the JS below) whenever the count is 0.
     --------------------------------------------------------- */
  .wishlist-header-count {
    display: none;
    position: absolute;
    top: -6px;
    right: -8px;
    min-width: 16px;
    height: 16px;
    padding: 0 3px;
    border-radius: 8px;
    background: #E50047;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    line-height: 16px;
    text-align: center;
  }
  .wishlist-header-count.visible {
    display: block;
  }
</style>

<script>
  (function () {
    /* Reads the wishlist's real item count directly from the
       "Notify Me!" app's own localStorage record (key:
       NM_customerData — confirmed via direct inspection to hold
       {"wishlists":[{"items":[...]}]}, updated correctly by the
       app itself on every add/remove). This is read-only — it
       never writes to this key, so there's no risk to the app's
       own data or behaviour. Polls periodically since localStorage
       changes don't fire an event within the same tab that made
       them (the native "storage" event only fires in OTHER tabs). */
    function getWishlistCount() {
      try {
        var raw = localStorage.getItem('NM_customerData');
        if (!raw) return 0;
        var data = JSON.parse(raw);
        var list = data && data.wishlists && data.wishlists[0];
        return list && Array.isArray(list.items) ? list.items.length : 0;
      } catch (e) {
        return 0;
      }
    }

    function updateWishlistBadge() {
      var badge = document.querySelector('.wishlist-header-count');
      if (!badge) return;
      var count = getWishlistCount();
      if (count > 0) {
        badge.textContent = count > 99 ? '99+' : String(count);
        badge.classList.add('visible');
      } else {
        badge.classList.remove('visible');
      }
    }

    updateWishlistBadge();
    setInterval(updateWishlistBadge, 800);

    /* Also re-check shortly after any click that's likely to have
       changed the wishlist, so the badge feels immediate rather
       than waiting for the next poll tick. */
    document.addEventListener('click', function (e) {
      if (
        e.target.closest('.nm-wishlist-button') ||
        e.target.closest('.nm-wishlist-open-list-button')
      ) {
        setTimeout(updateWishlistBadge, 400);
        setTimeout(updateWishlistBadge, 1200);
      }
    });
  })();
</script>


    
