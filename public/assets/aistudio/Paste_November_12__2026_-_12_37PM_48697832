  function updateModalVariant() {
    var selects = optGroups.querySelectorAll('.nj-rv__opt-select');
    if (!selects.length) return;
    var chosen = Array.from(selects).map(function(s) { return s.value; });
    var match  = allVariants.find(function(v) {
      return v.options.every(function(o, i) { return o === chosen[i]; });
    });
    if (match) {
      activeCard && (activeCard.dataset.variantId = match.id);
      if (match.price) {
        var formatted = (match.price / 100).toLocaleString('en-IN', { style: 'currency', currency: 'INR', minimumFractionDigits: 2 });
        modalPrice.textContent = formatted;
      }
      if (!match.available) {
        atcBtn.classList.add('state-oos'); atcBtn.disabled = true;
        atcBtn.querySelector('.nj-btn-text').textContent = 'OUT OF STOCK';
      } else {
        atcBtn.classList.remove('state-oos'); atcBtn.disabled = false;
        atcBtn.querySelector('.nj-btn-text').textContent = activeCard ? (activeCard.dataset.btnText || 'ADD TO CART') : 'ADD TO CART';
      }
    }
  }

  function openModal(card) {
    activeCard       = card;
    currentProdUrl   = card.dataset.productUrl || '#';
    var title        = card.dataset.productTitle || '';
    var price        = card.dataset.productPrice || '';
    var imgSrc       = card.dataset.productImg || '';
    var videoUrl     = card.dataset.videoUrl || '';
    var hasV         = card.dataset.hasVariants === 'true';
    var btnLabel     = card.dataset.btnText || 'ADD TO CART';
    var isAvailable  = card.dataset.available !== 'false';

    modalName.textContent  = title;
    modalPrice.textContent = price;
    modalImg.src = imgSrc; modalImg.alt = title;
    atcBtn.querySelector('.nj-btn-text').textContent = btnLabel;

    var varsRaw = (card.dataset.variantsJson || '[]').replace(/&quot;/g,'"').replace(/&#39;/g,"'");
    var optsRaw = (card.dataset.optionsJson  || '[]').replace(/&quot;/g,'"').replace(/&#39;/g,"'");
    try { allVariants = JSON.parse(varsRaw); } catch(_) { allVariants = []; }

    optGroups.innerHTML = '';
    if (hasV) {
      try {
        var opts = JSON.parse(optsRaw);
        opts.forEach(function(opt, i) {
          var grp = document.createElement('div');
          grp.className = 'nj-rv__opt-group';
          var lbl = document.createElement('label');
          lbl.className = 'nj-rv__opt-label';
          lbl.textContent = opt.name;
          var sel = document.createElement('select');
          sel.className = 'nj-rv__opt-select';
          sel.dataset.optIndex = i;
          opt.values.forEach(function(val) {
            var o = document.createElement('option');
            o.value = val; o.textContent = val;
            sel.appendChild(o);
          });
          sel.addEventListener('change', updateModalVariant);
          grp.appendChild(lbl); grp.appendChild(sel);
          optGroups.appendChild(grp);
        });
        updateModalVariant();
      } catch(_) {}
    }
    variantPanel.classList.add('hidden');

    if (!isAvailable) {
      atcBtn.classList.add('state-oos'); atcBtn.disabled = true;
      atcBtn.querySelector('.nj-btn-text').textContent = 'OUT OF STOCK';
      prodLink.classList.add('state-oos'); prodLink.disabled = true;
    } else {
      atcBtn.classList.remove('state-oos'); atcBtn.disabled = false;
      prodLink.classList.remove('state-oos'); prodLink.disabled = false;
    }

    modalVideo.muted = isMuted;
    if (videoUrl) {
      modalVideo.src = videoUrl;
      modalVideo.play().catch(function() {});
    } else {
      var th = card.querySelector('.nj-rv__card-thumb');
      if (th) modalVideo.poster = th.src;
      modalVideo.src = '';
    }

    resetAtc();
    if (!isAvailable) {
      atcBtn.classList.add('state-oos'); atcBtn.disabled = true;
      atcBtn.querySelector('.nj-btn-text').textContent = 'OUT OF STOCK';
    }

    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    document.documentElement.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closeModal() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    modalVideo.pause(); modalVideo.src = '';
    document.body.style.overflow = '';
    document.documentElement.style.overflow = '';
    if (activeCard) activeCard.focus();
    activeCard = null;
  }

  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });
  prodLink.addEventListener('click', function() { if (currentProdUrl !== '#') window.location.href = currentProdUrl; });

  /* Mute */
  muteBtn.addEventListener('click', function() {
