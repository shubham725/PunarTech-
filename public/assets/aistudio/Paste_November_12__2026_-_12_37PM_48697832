<script>
(function () {
  'use strict';

  var SECTION_ID = 'template--28095820366006__nj_video_reels_HdNnM6';
  var GAP        = 12;

  var section    = document.getElementById('nj-rv-' + SECTION_ID);
  var track      = document.getElementById('nj-rv-track-' + SECTION_ID);
  if (!section || !track) return;

  /* ── MOBILE-ONLY LAZY INIT ─────────────────────────────
     On screens ≤ 640px, defer all JS until the section is
     ~300px away from the viewport. Desktop runs immediately
     exactly as before. No other code is changed.
  ─────────────────────────────────────────────────────── */
  if (window.innerWidth <= 640) {
    var mobileIO = new IntersectionObserver(function(entries, obs) {
      if (!entries[0].isIntersecting) return;
      obs.disconnect();
      init();
    }, { rootMargin: '300px 0px' });
    mobileIO.observe(section);
  } else {
    init();
  }

  function init() {

  var prevBtn    = section.querySelector('.nj-rv__arrow--prev');
  var nextBtn    = section.querySelector('.nj-rv__arrow--next');
  var modal      = document.getElementById('nj-rv-modal');
  var modalVideo = document.getElementById('nj-rv-modal-video');
  var muteBtn    = document.getElementById('nj-rv-mute');
  var muteIcon   = document.getElementById('nj-rv-mute-icon');
  var closeBtn   = document.getElementById('nj-rv-close');
  var modalImg   = document.getElementById('nj-rv-modal-img');
  var modalName  = document.getElementById('nj-rv-modal-name');
  var modalPrice = document.getElementById('nj-rv-modal-price');
  var variantPanel = document.getElementById('nj-rv-variant-panel');
  var optGroups    = document.getElementById('nj-rv-opt-groups');
  var allVariants  = [];
  var atcBtn     = document.getElementById('nj-rv-atc');
  var prodLink   = document.getElementById('nj-rv-prod-link');
  var toast      = document.getElementById('nj-rv-toast');

  var cards      = Array.from(track.querySelectorAll('.nj-rv__card'));
  var total      = cards.length;
  var idx        = 0;
  var isMuted    = true;
  var activeCard = null;
  var toastTimer = null;
  var currentProdUrl = '#';
  var openPanelCard  = null;

  /* ── Breakpoint → visible count ── */
  function vc() {
    var w = track.parentElement.offsetWidth;
    if (w > 1200) return 5;
    if (w > 960)  return 4;
    if (w > 640)  return 3;
    return 1;
  }
  function cw() {
    return (track.parentElement.offsetWidth - (vc() - 1) * GAP) / vc();
  }

  /* ── Slide ── */
  function slideTo(n) {
    idx = Math.min(Math.max(n, 0), Math.max(0, total - vc()));
    track.style.transform = 'translateX(-' + idx * (cw() + GAP) + 'px)';
    prevBtn.hidden = idx === 0;
    nextBtn.hidden = idx >= total - vc();
  }

  prevBtn.addEventListener('click', function() { slideTo(idx - 1); });
  nextBtn.addEventListener('click', function() { slideTo(idx + 1); });
  window.addEventListener('resize', function() { slideTo(idx); }, { passive: true });

  /* ── Swipe ── */
  var tx = 0, ty = 0;
  track.addEventListener('touchstart', function(e) { tx = e.touches[0].clientX; ty = e.touches[0].clientY; }, { passive: true });
  track.addEventListener('touchend', function(e) {
    var dx = tx - e.changedTouches[0].clientX;
    var dy = Math.abs(ty - e.changedTouches[0].clientY);
    if (dy > Math.abs(dx)) return;
    if (dx > 40) slideTo(idx + 1); else if (dx < -40) slideTo(idx - 1);
  }, { passive: true });

  /* ── Lazy video + auto-play ── */
  var io = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      var video = e.target.querySelector('.nj-rv__card-video');
      if (!video) return;
      if (e.isIntersecting) {
        if (!video.src && video.dataset.src) video.src = video.dataset.src;
        video.play().catch(function() {});
      } else {
        video.pause();
      }
    });
  }, { threshold: 0.5 });
  cards.forEach(function(c) { io.observe(c); });

  /* ══════════════════════════════════════
     INLINE VARIANT PANEL LOGIC
  ══════════════════════════════════════ */

  function closeInlinePanel() {
    if (!openPanelCard) return;
    openPanelCard.classList.remove('variants-open');
    openPanelCard = null;
  }

  function parseJSON(raw) {
    if (!raw) return [];
    try { return JSON.parse(raw); }
    catch(_) {
      try {
        return JSON.parse(
          raw.replace(/&quot;/g, '"')
             .replace(/&#39;/g, "'")
             .replace(/&amp;/g, '&')
             .replace(/&lt;/g, '<')
             .replace(/&gt;/g, '>')
        );
      } catch(e2) { console.warn('[nj-reels] JSON parse failed:', e2, raw); return []; }
    }
  }

  function buildInlinePanel(card) {
    var panel     = card.querySelector('.nj-rv__inline-panel');
    var grpWrap   = card.querySelector('.nj-rv__inline-opt-groups');
    var inlineAtc  = card.querySelector('.nj-rv__inline-atc');
    var inlineLink = card.querySelector('.nj-rv__inline-atc-chevron');
    var btnText    = card.dataset.btnText || 'ADD TO CART';
    var hasV       = card.dataset.hasVariants === 'true';
    var variants   = parseJSON(card.dataset.variantsJson || '[]');
    var opts       = parseJSON(card.dataset.optionsJson   || '[]');
    var prodUrl    = card.dataset.productUrl || '#';
    var available  = card.dataset.available !== 'false';

    grpWrap.innerHTML = '';

    inlineLink.onclick = function(e) {
      e.stopPropagation();
      if (prodUrl !== '#') window.location.href = prodUrl;
    };

    var heading = panel.querySelector('.nj-rv__inline-panel-heading');

    if (!hasV || !opts.length) {
      if (heading) heading.style.display = 'none';
      setupInlineAtc(card, inlineAtc, card.dataset.variantId, btnText, available);
      return;
    }

    if (heading) heading.style.display = '';

    opts.forEach(function(opt, i) {
      var grp = document.createElement('div');
      grp.className = 'nj-rv__inline-opt-group';

      var lbl = document.createElement('label');
      lbl.className = 'nj-rv__inline-opt-label';
      lbl.textContent = opt.name;

      var sel = document.createElement('select');
      sel.className = 'nj-rv__inline-opt-select';
      sel.dataset.optIndex = i;

      opt.values.forEach(function(val) {
        var o = document.createElement('option');
        o.value = val; o.textContent = val;
        sel.appendChild(o);
      });

      sel.addEventListener('change', function(e) {
        e.stopPropagation();
        syncInlineVariant(card, grpWrap, variants, inlineAtc, btnText);
      });

      grp.appendChild(lbl);
      grp.appendChild(sel);
      grpWrap.appendChild(grp);
    });

    syncInlineVariant(card, grpWrap, variants, inlineAtc, btnText);
  }

  function syncInlineVariant(card, grpWrap, variants, inlineAtc, btnText) {
    var selects = grpWrap.querySelectorAll('.nj-rv__inline-opt-select');
    var chosen  = Array.from(selects).map(function(s) { return s.value; });
    var match   = variants.find(function(v) {
      return v.options.every(function(o, i) { return o === chosen[i]; });
    });
    if (match) {
      card.dataset.variantId = match.id;
      var btn = card.querySelector('.nj-rv__inline-atc');
      setupInlineAtc(card, btn, match.id, btnText, !!match.available);
    }
  }

  function setupInlineAtc(card, btn, variantId, btnText, available) {
    var textEl = btn.querySelector('.nj-btn-text');
    textEl.textContent = available ? btnText : 'OUT OF STOCK';
    btn.disabled = !available;
    var fresh = btn.cloneNode(true);
    btn.parentNode.replaceChild(fresh, btn);
    btn = card.querySelector('.nj-rv__inline-atc');
    btn.querySelector('.nj-btn-text').textContent = available ? btnText : 'OUT OF STOCK';
    btn.disabled = !available;
    if (available) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        addToCart(variantId, btn, function() {
          btn.querySelector('.nj-btn-text').textContent = '✓ Added to Cart';
          setTimeout(function() {
            btn.querySelector('.nj-btn-text').textContent = btnText;
          }, 2800);
        });
      });
    }
  }

  function toggleInlinePanel(card) {
    var isOpen = card.classList.contains('variants-open');
    if (openPanelCard && openPanelCard !== card) closeInlinePanel();

    if (isOpen) {
      closeInlinePanel();
    } else {
      buildInlinePanel(card);
      card.classList.add('variants-open');
      openPanelCard = card;
    }
  }

  /* Close panel on outside click */
  document.addEventListener('click', function(e) {
    if (openPanelCard && !openPanelCard.contains(e.target)) closeInlinePanel();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeInlinePanel();
      if (modal.classList.contains('is-open')) closeModal();
    }
  });

  /* ── Card click delegation ── */
  cards.forEach(function(card) {
    card.addEventListener('click', function(e) {
      var chipAtc = e.target.closest('.nj-rv__chip-atc');
      if (chipAtc) {
        e.stopPropagation();
        if (!chipAtc.disabled) addToCart(chipAtc.dataset.variantId, chipAtc, null);
        return;
      }
      var chev = e.target.closest('.nj-rv__chip-chevron');
      if (chev) {
        e.stopPropagation();
        var hasV = card.dataset.hasVariants === 'true';
        if (hasV) {
          toggleInlinePanel(card);
        } else {
          var u = card.dataset.productUrl; if (u) window.location.href = u;
        }
        return;
      }
      if (e.target.closest('.nj-rv__inline-panel')) return;

      openModal(card);
    });
  });

  /* ══════════════════════════════════════
